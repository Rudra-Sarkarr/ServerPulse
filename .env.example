# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=   # Optional: Guild ID for fast slash command sync (leave blank for global)

# Live Auto-Updating Dashboard Channel ID
# (Channel where bot updates a single persistent message every REFRESH_INTERVAL seconds)
MONITOR_CHANNEL_ID=

# Alert Channel ID
# (Channel where bot posts warning alerts when CPU, RAM, or Disk cross thresholds)
ALERT_CHANNEL_ID=

# Refresh Interval for Live Dashboard (in seconds, default 10)
# Note: Keep >= 5 seconds to comply with Discord API rate limits
REFRESH_INTERVAL=10

# Resource Alert Thresholds (Percentages 1-100)
CPU_ALERT_THRESHOLD=85
RAM_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90

# Alert Cooldown (seconds before sending another alert for the same resource)
ALERT_COOLDOWN=300

# Security: Allowed Role or User IDs for administrative/sensitive commands (comma-separated)
# Leave blank to allow anyone with permission in server
ALLOWED_ROLES=
